erDiagram
%% ============================================================
%% ERD (VERSI INTI RINGKAS) — Sistem Informasi TVRI Stasiun D.I. Yogyakarta
%% Versi ringkas yang hanya memuat tabel-tabel inti dengan FK nyata,
%% agar diagram tetap terbaca pada lebar layar GitHub.
%% Struktur lengkap (semua 27 tabel, termasuk tabel informasi
%% yang berdiri sendiri) ada pada erd.mmd.
%% ============================================================
    users {
        bigint id PK
        string name
        string username UK
        string email UK
        string password
        string role "default secondary: admin|secondary|pegawai"
        string remember_token "nullable"
    }
    sessions {
        string id PK
        bigint user_id FK "nullable"
        string ip_address "varchar 45, nullable"
        text user_agent "nullable"
        longtext payload
        int last_activity
    }
    password_reset_tokens {
        string email PK
        string token
        timestamp created_at "nullable"
    }
    users |o--o{ sessions : "sesi login (user_id)"
    users ||--o{ password_reset_tokens : "email (relasi logis)"

    posts {
        bigint id PK
        bigint user_id FK "CASCADE"
        bigint category_id FK "RESTRICT"
        string title
        string slug UK
        text body
        string featured_image "nullable"
        string link_postingan "nullable"
        enum status "draft|published"
        timestamp published_at "nullable"
        biginteger views "default 0"
    }
    categories {
        bigint id PK
        string name
        string slug UK
        string color
    }
    news {
        bigint id PK
        bigint user_id FK "CASCADE"
        bigint news_category_id FK "RESTRICT"
        string title
        string slug UK
        text body
        string featured_image "nullable"
        string link_berita "nullable"
        enum status "draft|published"
        timestamp published_at "nullable"
        biginteger views "default 0"
    }
    news_categories {
        bigint id PK
        string name
        string slug UK
        string color "default blue"
    }
    broadcasts {
        bigint id PK
        bigint user_id FK "RESTRICT"
        bigint broadcast_category_id FK "RESTRICT"
        string title
        string slug UK
        text synopsis "nullable"
        string poster "nullable"
        string youtube_link "nullable"
        enum status "draft|published"
        bool is_active "1 = Sedang Produksi, 0 = Selesai"
        timestamp published_at "nullable"
    }
    broadcast_categories {
        bigint id PK
        string name
        string slug UK
        string color "default blue"
    }
    jadwal_acaras {
        bigint id PK
        string title
        string slug UK
        time start_time
        time end_time "nullable"
        bigint broadcast_category_id FK "RESTRICT"
        bigint jadwal_category_id FK "nullable, SET NULL"
        bool is_active "default true"
    }
    jadwal_categories {
        bigint id PK
        string name
        string slug UK
        int order "default 0"
        string color "default blue"
    }
    comments {
        bigint id PK
        string commentable_type "morphs: News, Post, Broadcast"
        biginteger commentable_id "morphs"
        string name
        string email
        text body
        tinyint rating "nullable, 1-5"
        enum status "pending|approved|rejected"
    }

    users ||--o{ posts : "user_id CASCADE"
    users ||--o{ news : "user_id CASCADE"
    users ||--o{ broadcasts : "user_id RESTRICT"
    categories ||--o{ posts : "category_id RESTRICT"
    news_categories ||--o{ news : "news_category_id RESTRICT"
    broadcast_categories ||--o{ broadcasts : "broadcast_category_id RESTRICT"
    broadcast_categories ||--o{ jadwal_acaras : "broadcast_category_id RESTRICT"
    jadwal_categories |o--o{ jadwal_acaras : "jadwal_category_id SET NULL"
    posts ||--o{ comments : "commentable"
    news ||--o{ comments : "commentable"
    broadcasts ||--o{ comments : "commentable"
