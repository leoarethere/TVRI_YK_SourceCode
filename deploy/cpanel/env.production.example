APP_NAME="TVRI D.I. Yogyakarta"
APP_ENV=production
APP_KEY=BASE64_KEY_DARI_ENV_LIVE_LAMA
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://yogyakarta.tvri.go.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=NAMA_DATABASE_CPANEL
DB_USERNAME=USER_DATABASE_CPANEL
DB_PASSWORD=PASSWORD_DATABASE_CPANEL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=tvri_yogyakarta_

# Pilih SMTP/API mail provider yang memang diizinkan perusahaan.
# Tanpa mail transport, email reset password tidak akan terkirim.
MAIL_MAILER=smtp
MAIL_TIMEOUT=10
MAIL_HOST=HOST_MAIL_PROVIDER
MAIL_PORT=587
MAIL_USERNAME=USERNAME_MAIL_PROVIDER
MAIL_PASSWORD=PASSWORD_ATAU_API_KEY_MAIL_PROVIDER
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@DOMAIN_YANG_TERVERIFIKASI
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

